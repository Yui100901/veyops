# Copy to .env. Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_CLIENT=sqlite
DATABASE_PATH=./data/database/app.db
# DATABASE_URL=postgresql://veyops:password@localhost:5432/veyops
DATA_DIR=./data
# Required in production; 64 hex characters. In development, generated in data/config/encryption.key.
ENCRYPTION_KEY=
# First startup only. Leave empty to generate the root password and print it once.
ADMIN_PASSWORD=
# Disable the Worker inside the API process when using a dedicated Worker.
WORKER_ENABLED=true
WORKER_CONCURRENCY=1
# Default build location, target parallelism and log retention are configured under System Settings.
DEFAULT_AI_PERMISSION=CONFIRM
# Optional manager builds: a trusted helper image plus accessible local Docker CLI/daemon.
BUILD_HELPER_IMAGE=node:22-bookworm
# Auto-builds use a dedicated, same-user Linux rootless Docker Unix socket.
# WEBHOOK_BUILD_DOCKER_SOCKET=/run/user/1000/docker.sock
# AI is optional and managed in System Settings. Do not put API keys in source control.
AI_PIPELINE_ANALYSIS=false
# Set true when served behind HTTPS.
COOKIE_SECURE=false
