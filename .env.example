# Copy to .env. Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_CLIENT=sqlite
DATABASE_PATH=./data/database/app.db
# DATABASE_URL=postgresql://veyops:password@localhost:5432/veyops
DATA_DIR=./data
# Required in production; 64 hex characters. In development, generated in data/config/encryption.key.
ENCRYPTION_KEY=
WORKER_ENABLED=true
WORKER_CONCURRENCY=1
DEFAULT_MAX_PARALLEL_TARGETS=3
DEFAULT_BUILD_LOCATION=TARGET
DEFAULT_AI_PERMISSION=CONFIRM
# Optional manager builds: a trusted helper image plus accessible local Docker CLI/daemon.
BUILD_HELPER_IMAGE=node:22-bookworm
# AI is optional and managed in System Settings. Do not put API keys in source control.
# Set true when served behind HTTPS.
COOKIE_SECURE=false
